# Generated by `profile-gen settings --env-example`. Copy to .env to use locally.

# Markdown template with {{ placeholders }}.
PROFILE_TEMPLATE=template.md

# Where the rendered profile is written.
PROFILE_OUTPUT=README.md

# Portfolio stats (hackathons, festivals, Untappd).
PROFILE_STATS_URL=https://seanomahoney.com/stats.json

# SteamID64 whose recent games are shown.
PROFILE_STEAM_ID=76561198101964519

# Steam Web API key. Leave empty to skip Steam.
# Also read from: STEAM_API_KEY
PROFILE_STEAM_API_KEY=

# How many recently played games to show.
PROFILE_STEAM_GAMES=5

# How many recent games to request before filtering.
PROFILE_STEAM_FETCH=10

# Steam content descriptor ids to hide (3 = adult only sexual content).
PROFILE_STEAM_BLOCKED_DESCRIPTORS=3

# HTTP timeout in seconds per request.
PROFILE_TIMEOUT=20.0

# Retries for transient HTTP failures (5xx, 429, network).
PROFILE_RETRIES=2

# Use bundled demo data instead of the network.
PROFILE_OFFLINE=false

# Exit non-zero if any source fails (instead of its fallback text).
PROFILE_STRICT=false

